#!/usr/bin/env bash

# Refreshes the copy of the CUE syntax corpus in test/syntax from a checkout
# of cue-lang/cue, which must be exactly at a tag, and records the tag in
# test/syntax/SOURCE. The corpus is the .cue files in the checkout's
# cue/parser/testdata/syntax; corpus files that the checkout no longer has,
# and any directories, are removed. Run script/parse-syntax-corpus
# afterwards.
#
# Usage: script/sync-syntax-corpus <cue-checkout>

set -euo pipefail

if [ $# -ne 1 ]; then
	echo "usage: $0 <cue-checkout>" >&2
	exit 2
fi
checkout=$1

if ! tag=$(git -C "$checkout" describe --exact-match --tags 2>/dev/null); then
	echo "$checkout is not a git checkout exactly at a tag" >&2
	exit 1
fi

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
CORPUS=$(dirname "$SCRIPT_DIR")/test/syntax
src=$checkout/cue/parser/testdata/syntax

shopt -s nullglob
files=("$src"/*.cue)
if [ ${#files[@]} -eq 0 ]; then
	echo "no corpus files in $src" >&2
	exit 1
fi

for old in "$CORPUS"/*.cue; do
	if [ ! -f "$src/$(basename "$old")" ]; then
		rm "$old"
	fi
done
for old in "$CORPUS"/*/; do
	rm -r "$old"
done
cp "${files[@]}" "$CORPUS"/
echo "cue-lang/cue $tag" >"$CORPUS/SOURCE"
echo "copied ${#files[@]} corpus files from cue-lang/cue $tag"
